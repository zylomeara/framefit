# docker compose interpolation vars (cp to docker/.env).
# The local profile needs little or nothing of this; production needs the full block —
# see docker/README.md § 2 for the complete required prod checklist.

# local profile only: Figma PAT for real Figma calls (health/initialize work without it)
# FIGMA_TOKEN=figd_...

# local profile: the image already binds 0.0.0.0 inside the container (docker/Dockerfile); the
# compose port mapping is what keeps it on 127.0.0.1 of the HOST. Do not set BIND_HOST here.

# full (postgres): defaults to devpassword locally; set a real one on prod
# POSTGRES_PASSWORD=<openssl rand -hex 16>

# full (prod) only — points the multi-tenant server at your external Keycloak / OIDC IdP:
# COMPOSE_PROFILES=full
# KEYCLOAK_JWKS_URL=https://auth.example.com/realms/mcp/protocol/openid-connect/certs
# OAUTH_AUTHORIZATION_SERVER=https://auth.example.com/realms/mcp
# MCP_HOST=figma.mcp.example.com
# PUBLIC_BASE_URL=https://figma.mcp.example.com
