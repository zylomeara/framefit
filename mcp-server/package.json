{
  "name": "framefit",
  "version": "0.26.0",
  "description": "Verification-first headless Figma MCP server for AI agents — deterministic design QA that measures a rendered UI against the frame",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "bin": {
    "framefit": "dist/index.js"
  },
  "license": "MIT",
  "author": "Artem Babak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zylomeara/framefit.git",
    "directory": "mcp-server"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node -e \"const fs=require('fs');fs.existsSync('.env')||fs.writeFileSync('.env','')\" && node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "test": "vitest run --exclude tests/e2e",
    "test:watch": "vitest --exclude tests/e2e",
    "test:e2e": "vitest run tests/e2e",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "prepublishOnly": "rm -rf dist && pnpm build",
    "prepack": "node -e \"for (const f of ['README.md','LICENSE']) require('fs').copyFileSync('../'+f, f)\"",
    "postpack": "node -e \"for (const f of ['README.md','LICENSE']) require('fs').rmSync(f, { force: true })\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "fuse.js": "^7.0.0",
    "jimp": "^1.6.1",
    "jose": "^6.2.3",
    "pg": "^8.21.0",
    "pino": "^9.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/pg": "^8.20.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0"
}
