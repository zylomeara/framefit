# ── Core (single-tenant) ─────────────────────────────────────────────────────
# Transport: "http" (default, for VPS/docker deploy) or "stdio" (host spawns the
# process and speaks JSON-RPC over stdin/stdout, e.g. local Claude Code — pass
# FIGMA_TOKEN via the MCP client's env block, not this file).
MCP_TRANSPORT=http
PORT=3846
# Local interface to bind; loopback when unset - the single-tenant server has no auth of its own.
# NOT the same thing as MCP_HOST below: MCP_HOST is the PUBLIC hostname the multi-tenant server
# advertises itself at; BIND_HOST is the interface the socket binds. Set 0.0.0.0 only when
# something in front of it provides authentication (the container image sets it for exactly that
# reason). Note: 127.0.0.1 is IPv4-only, so a client configured with http://localhost:PORT may
# resolve to ::1 and fail to connect - use 127.0.0.1 in client config, or set BIND_HOST=::1.
# Commented out (not an active assignment) for the SAME reason as FIGMA_TOKEN below: docker
# compose feeds this file to the container through `env_file` (docker/docker-compose.yml, full
# profile), env_file beats the image's own `ENV BIND_HOST=0.0.0.0`, and a copied .env carrying an
# active loopback line therefore kills the published port - the container binds 127.0.0.1 inside
# its own namespace, the mapped port answers nothing, and the healthcheck goes unhealthy. The
# schema default already supplies loopback for non-container runs, so uncomment this ONLY to
# override it (e.g. BIND_HOST=::1), never to restate the default.
# BIND_HOST=127.0.0.1
# Figma personal access token. Commented out (not `FIGMA_TOKEN=`) on purpose: a copied
# .env with an empty assignment would inject an empty string via docker's env_file.
# The server coerces '' to "unset" anyway (config.ts), but don't rely on it.
# FIGMA_TOKEN=figd_...
# Refuse every write tool (post_comment, reply_to_comment, delete_comment) on this connection.
# Only the exact value "true" (any case) enables it; anything else, including a typo, leaves
# writes enabled rather than crashing the server. Multi-tenant ignores this - there the flag is
# per-user and lives in the database.
# FRAMEFIT_READ_ONLY=true
LOG_LEVEL=info
NODE_ENV=production

# Public base URL (no trailing slash) for browser-facing URLs (extractor loader,
# dom-snapshot upload_url). Single-tenant http defaults to the actual bound
# http://127.0.0.1:<port> when unset; stdio never emits these URLs at all.
# Multi-tenant: overrides https://$MCP_HOST (must match the Keycloak audience).
# PUBLIC_BASE_URL=https://figma.mcp.example.com

# Extra origins the /mcp origin guard will not refuse, comma-separated. Read that literally: it
# stops this guard from refusing them, and nothing more. It does NOT make a browser tool work.
# Cross-origin browser use of /mcp does not work as shipped, whatever is listed here - nothing sets
# CORS response headers on /mcp, and the MCP transport answers OPTIONS with 405, so a listed
# origin's preflight is refused and even a POST it did make would be unreadable to the page. Making
# a browser tool talk to /mcp would take a CORS layer this server does not ship; listing an origin
# is necessary but not sufficient.
# The server always admits its own advertised origins anyway (BIND_HOST:PORT, localhost:PORT,
# PUBLIC_BASE_URL, and https://$MCP_HOST in multi-tenant); this setting is the escape hatch so the
# guard can never become an unopenable door. Given the above, what it can actually rescue is a
# non-browser client or proxy that sends an Origin header anyway, not a browser page.
# Requests with NO Origin header - every ordinary MCP client - are unaffected by this setting.
# Empty means no extras.
# ALLOWED_ORIGINS=https://studio.example.com

# ── Figma API behavior ───────────────────────────────────────────────────────
# Per-request timeout to the Figma REST API (ms).
FIGMA_TIMEOUT_MS=90000
# Per-call time budget for stage degradation in heavy tools (ms, 5000..600000).
FIGMA_TOOL_TIME_BUDGET_MS=90000
# Cap on concurrent heavy subtree fetches (set 1 on memory-constrained hosts).
FIGMA_MAX_CONCURRENT_REQUESTS=2
# Depth of the cached file-structure skeleton fetch (1..10).
FILE_STRUCTURE_DEPTH=4

# ── Caches / memory ceilings ─────────────────────────────────────────────────
FILE_STRUCTURE_TTL_SEC=300
# Longer TTL for low-churn published DS library content (search_design_system); default 24h.
DS_LIBRARY_TTL_SEC=86400
# Single-tenant design-system team ids (comma-separated bare digits or figma.com/team/<id> URLs).
# When set (with FIGMA_TOKEN), the teams' published variable libraries are synced into an in-memory
# graph so cross-library aliases resolve headless (resolved_via:"graph") — no portal/DB needed.
# Unset → aliases stay honestly unresolved. Do NOT set under MULTI_TENANT (that mode is per-user).
# The first graph-needing call (get_variables / get_design_context / compare_node_to_dom) after
# startup blocks while those libraries sync — several minutes on a large DS (measured ~11 libs /
# 7000+ vars), one-time per process; later calls are fast and the call is not hung.
# DS_TEAM_IDS=1234567890,9876543210
# Max chars of a single tool result before honest clamping.
MAX_RESULT_CHARS=40000
# OOM backstop on a single Figma REST fetch (bytes; stream-aborts past this).
MAX_FETCH_BYTES=134217728
# A raw response bigger than this is delivered but NOT cached (bytes).
CACHE_MAX_ENTRY_BYTES=67108864
# Aggregate resident byte ceiling across ALL read caches (process-wide).
CACHE_MAX_BYTES=268435456

# ── Frame hydration (deep-fetch RAM cache) ───────────────────────────────────
# A fetched frame whose wire size exceeds this is delivered but not held (bytes).
FRAME_MAX_PARSE_BYTES=3145728
# Global / per-tenant resident (parsed) ceilings for held frames (bytes).
FRAME_RAM_GLOBAL_BYTES=50331648
FRAME_RAM_PER_TENANT_BYTES=16777216
# Wire→resident multiplier used to account held frames against the ceilings.
FRAME_PARSE_MULTIPLIER=5
# Process-wide cap on concurrent parse-into-heap hydrations.
HYDRATION_MAX_MATERIALIZE=1
# TTL (seconds) for a held frame raw.
FRAME_CACHE_TTL_SEC=300

# ── For e2e tests only (not used at runtime) ─────────────────────────────────
FIGMA_TOKEN_E2E=
E2E_FILE_URL=
# Cross-library variable-mode e2e (tests/e2e/variable-mode-cross-library.test.ts):
FIGMA_E2E_TOKEN=
FIGMA_E2E_FILE=
FIGMA_E2E_NODE=
FIGMA_E2E_SOURCE_LIB=

# ── Multi-tenant mode (optional; single-tenant works without this block) ─────
# MULTI_TENANT=true
# DATABASE_URL=postgresql://mcp:<password>@figma-postgres:5432/figma_mcp
# ENCRYPTION_KEY=<openssl rand -hex 32>
# KEYCLOAK_JWKS_URL=https://auth.example.com/realms/mcp/protocol/openid-connect/certs
# OAUTH_AUTHORIZATION_SERVER=https://auth.example.com/realms/mcp
# MCP_HOST=figma.mcp.example.com
# Optional overrides of the https://$MCP_HOST-derived defaults:
# PUBLIC_BASE_URL=http://localhost:3846
# EXPECTED_AUDIENCE=https://figma.mcp.example.com/mcp
# EXPECTED_AZP=figma-portal
# Hard-enforce JWT audience on /accounts once Keycloak audience mappers exist:
# ENFORCE_AUDIENCE=true
